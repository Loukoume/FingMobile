<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@color/white">

    <!-- Contenu principal -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toEndOf="@id/statusStripe">

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24/07/2025"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/labelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RETRAIT GAB ONUS"
            android:textSize="14sp"
            android:textColor="@color/black" />
    </LinearLayout>

    <!-- Bande verticale colorée, hauteur égale au contenu -->
    <View
        android:id="@+id/statusStripe"
        android:layout_width="6dp"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/contentLayout"
        android:layout_alignBottom="@id/contentLayout"
        android:layout_alignParentStart="true"
        android:layout_marginEnd="8dp"
        android:background="@color/red" /> <!-- vert pour dépôt, rouge pour retrait -->

    <!-- Montant aligné en haut à droite -->
    <TextView
        android:id="@+id/montantText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:text="-20 000 XOF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/red" />

</RelativeLayout>
