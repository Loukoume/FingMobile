<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/colorSendre"
    android:layout_height="match_parent"
    android:paddingBottom="100dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:background="@color/colorSendre"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/top"
            android:visibility="gone"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <TextView
                android:id="@+id/tv_step_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informations Émetteur"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp" />
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="@color/colorPrimary"
                android:layout_height="1dp">
            </View>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:background="@color/colorSendre"
            android:layout_height="wrap_content">
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:orientation="vertical"
                android:background="@color/colorSendre"
                android:id="@+id/cord"
                android:paddingVertical="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                     android:id="@+id/main"
                    android:layout_marginTop="@dimen/fab_margin"
                    android:paddingHorizontal="@dimen/fab_margin"
                    android:paddingVertical="@dimen/fab_margin"
                    android:orientation="vertical"
                    android:background="@drawable/shape_vide"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textFieldCpEmt"
                        android:layout_width="match_parent"
                        app:hintTextColor="@color/colorAccent"
                        app:hintEnabled="true"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="7dp"
                        app:boxCornerRadiusTopEnd="7dp"
                        app:boxCornerRadiusBottomStart="7dp"
                        app:boxCornerRadiusBottomEnd="7dp"
                        android:hint="Montant"
                        app:boxBackgroundColor="@color/white"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:id="@+id/idCpEmt"
                            android:inputType="numberDecimal"
                            android:layout_height="wrap_content"
                            />
                    </com.google.android.material.textfield.TextInputLayout>
                    <!-- Champ Numéro de compte -->
                    <androidx.coordinatorlayout.widget.CoordinatorLayout
                        android:layout_width="match_parent"
                        android:layout_marginTop="8dp"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/textField"
                                android:layout_width="match_parent"
                                app:boxBackgroundColor="@color/white"
                                app:boxBackgroundMode="outline"
                                app:boxCornerRadiusTopStart="7dp"
                                app:boxCornerRadiusTopEnd="7dp"
                                app:boxCornerRadiusBottomStart="7dp"
                                app:boxCornerRadiusBottomEnd="7dp"
                                android:layout_height="wrap_content">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:layout_width="match_parent"
                                    android:id="@+id/id"
                                    android:focusable="false"
                                    android:layout_height="wrap_content"
                                    />

                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:id="@+id/ups"
                            android:src="@drawable/baseline_arrow_drop_down_24"
                            android:layout_gravity="right|center"
                            android:layout_marginRight="@dimen/fab_margin"
                            app:tint="@color/colorSendre2"
                            android:layout_height="wrap_content">

                        </ImageView>
                    </androidx.coordinatorlayout.widget.CoordinatorLayout>
                    <!-- Champ Nom complet -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        app:boxBackgroundColor="@color/white"
                        android:id="@+id/fieldNom"
                        app:hintTextColor="@color/colorAccent"
                        android:hint="Nom complet"
                        android:layout_marginTop="8dp"
                        app:boxCornerRadiusTopStart="7dp"
                        app:boxCornerRadiusTopEnd="7dp"
                        app:boxCornerRadiusBottomStart="7dp"
                        app:boxCornerRadiusBottomEnd="7dp"
                        android:layout_height="wrap_content"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_full_name"
                            android:layout_width="match_parent"
                            android:focusable="false"
                            android:layout_height="wrap_content"

                            android:inputType="textPersonName"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:text="Émetteur"
                    android:layout_gravity="top|start"
                    android:textStyle="bold"
                    android:background="@drawable/shap_carre_vt"
                    android:paddingVertical="4dp"
                    android:textColor="@color/colorOnPromary"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/title"
                    android:layout_marginStart="@dimen/fab_margin"
                    android:layout_height="wrap_content">
                </TextView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_gravity="top|end"
                    android:textStyle="bold"
                    android:src="@drawable/baseline_arrow_right_24"
                    android:paddingVertical="4dp"
                    android:background="@null"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/up"
                    app:tint="@color/colorPrimary"
                    android:layout_marginEnd="@dimen/fab_margin"
                    android:layout_height="wrap_content">
                </ImageView>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:background="@color/colorSendre"
            android:layout_height="wrap_content">
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:orientation="vertical"
                android:background="@color/colorSendre"
                android:id="@+id/cord2"
                android:paddingVertical="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:id="@+id/main2"
                    android:layout_marginTop="@dimen/fab_margin"
                    android:paddingHorizontal="@dimen/fab_margin"
                    android:paddingVertical="@dimen/fab_margin"
                    android:orientation="vertical"
                    android:background="@drawable/shape_vide"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:id="@+id/lbene"
                        android:layout_height="wrap_content">
                        <include layout="@layout/input_drop_mt_outlin"/>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textFieldNom"
                            android:layout_width="match_parent"
                            app:hintTextColor="@color/colorAccent"
                            app:hintEnabled="true"
                            app:boxBackgroundMode="outline"
                            android:layout_marginTop="4dp"
                            app:boxCornerRadiusTopStart="7dp"
                            app:boxCornerRadiusTopEnd="7dp"
                            app:boxCornerRadiusBottomStart="7dp"
                            app:boxCornerRadiusBottomEnd="7dp"
                            android:hint="Nom complet"
                            app:boxBackgroundColor="@color/white"
                            android:layout_height="wrap_content">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:id="@+id/nom"
                                android:focusable="false"
                                android:layout_height="wrap_content"
                                />
                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:text="Bénéficiaire"
                    android:layout_gravity="top|start"
                    android:textStyle="bold"
                    android:background="@drawable/shap_carre_vt"
                    android:paddingVertical="4dp"
                    android:textColor="@color/colorOnPromary"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/title2"
                    android:layout_marginStart="@dimen/fab_margin"
                    android:layout_height="wrap_content">
                </TextView>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_gravity="top|end"
                    android:textStyle="bold"
                    android:src="@drawable/baseline_arrow_right_24"
                    android:paddingVertical="4dp"
                    android:background="@null"
                    android:paddingHorizontal="8dp"
                    android:id="@+id/up2"
                    app:tint="@color/colorPrimary"
                    android:layout_marginEnd="@dimen/fab_margin"
                    android:layout_height="wrap_content">
                </ImageView>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="@dimen/fab_margin"
             android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tv_label_beneficiary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Informations bénéficiaire"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp" />
            <View
                android:layout_width="match_parent"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="0dp"
                android:background="@color/colorPrimary"
                android:layout_height="1dp">
            </View>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
