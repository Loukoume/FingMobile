<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="8dp"
    app:cardElevation="0dp"
    app:cardCornerRadius="0dp"
    android:layout_marginTop="5sp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="50dp"
                android:visibility="gone"
                android:layout_marginVertical="13dp"
                android:id="@+id/image"
                android:layout_height="40dp">
            </ImageView>
            <TextView
                android:layout_width="40dp"
                android:text="M"
                 android:textSize="17dp"
                android:gravity="center"
                android:layout_gravity="center_vertical"
                android:background="@drawable/circle_background"
                android:backgroundTint="@color/colorPrimary"
                android:id="@+id/symbole"
                android:textColor="@color/white"
                android:layout_height="40dp">

            </TextView>
            <View
                android:layout_width="1dp"
                android:visibility="gone"
                android:background="@color/colorSendre"
                android:layout_height="match_parent">

            </View>
            <de.hdodenhof.circleimageview.CircleImageView
                android:layout_width="50dp"
                android:src="@drawable/user"
                android:id="@+id/circ_img"
                android:visibility="gone"
                app:civ_border_color="@color/colorSendre2"
                app:civ_border_width="1dp"
                android:layout_marginVertical="8dp"
                android:layout_margin="5dp"
                android:layout_height="50dp">

            </de.hdodenhof.circleimageview.CircleImageView>
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:padding="8dp"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="match_parent"
                    android:id="@+id/title"
                    android:singleLine="true"
                    android:textSize="17sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:text="Title"
                    android:layout_height="wrap_content">

                </TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:id="@+id/secondre"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:alpha="0.6"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/textColor"
                        android:text="Secondry text"
                        android:layout_height="wrap_content">
                    </TextView>
                    <TextView
                        android:layout_width="match_parent"
                        android:id="@+id/secondre2"
                        android:gravity="end"
                        android:visibility="gone"
                        android:alpha="0.7"
                        android:textStyle="normal"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/colorAccent"
                        android:textSize="15dp"
                        android:text="Secondry text"
                        android:layout_height="wrap_content">

                    </TextView>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_marginTop="5dp"
                    android:background="@color/colorSendre"
                    android:layout_height="1dp">
                </View>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_width="wrap_content"
            android:src="@drawable/ic_mort_noir"
            android:layout_gravity="right|top"
            android:id="@+id/ic_mort"
            android:elevation="10dp"
            android:visibility="gone"
            android:layout_margin="8dp"
            android:layout_height="wrap_content">
        </ImageView>
        <ProgressBar
            android:layout_width="30dp"
            android:layout_gravity="top|right"
            android:id="@+id/pbc"
            android:visibility="gone"
            android:layout_margin="5dp"
            android:layout_height="30dp">
        </ProgressBar>
        <ImageView
            android:id="@+id/not_sente"
            android:layout_width="16dp"
            android:visibility="gone"
            android:layout_height="16dp"
            android:layout_gravity="bottom|right"
            android:layout_margin="6dp"
            android:elevation="5dp"
            android:src="@drawable/ic_note_sent">
        </ImageView>
        <LinearLayout
            android:id="@+id/lnotif"
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:layout_gravity="top|right"
            android:layout_marginTop="6dp"
            android:layout_marginRight="@dimen/fab_margin"
            android:elevation="5dp">
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_width="wrap_content"
                    android:elevation="5dp"
                    android:id="@+id/notif"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/ic_notifications_black_24dp"
                    app:tint="@color/colorSendre2"
                    android:layout_height="wrap_content">
                </ImageView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_gravity="right|top"
                    android:text="0"
                    android:id="@+id/textnotif"
                    android:gravity="center"
                    android:paddingHorizontal="5dp"
                    android:layout_marginStart="10dp"
                    android:elevation="10dp"
                    android:textColor="@color/white"
                    android:background="@drawable/circle_background_red"
                    android:layout_marginBottom="@dimen/fab_margin"
                    android:layout_height="20dp">

                </TextView>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </LinearLayout>
        <View
            android:layout_width="10dp"
            android:id="@+id/star"
            android:visibility="gone"
            android:layout_gravity="top|left"
            android:background="@drawable/circle_background_red"
            android:layout_marginLeft="35dp"
            android:layout_marginTop="8dp"
            android:layout_height="10dp">
        </View>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.google.android.material.card.MaterialCardView>