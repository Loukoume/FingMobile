<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/tool_bar"></include>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:id="@+id/search"
            android:visibility="gone"
            android:elevation="@dimen/fab_margin"
            android:layout_height="wrap_content">
            <include layout="@layout/serch_tool_bar"></include>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginTop="?attr/actionBarSize"
            android:orientation="vertical"
            android:id="@+id/main"
            android:layout_height="wrap_content">
            <View
                android:layout_width="match_parent"
                android:layout_gravity="bottom"
                android:elevation="10dp"
                android:background="@color/colorAccent"
                android:layout_height="1dp">

            </View>
            <TextView
                android:id="@+id/wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/rouge"
                android:drawableLeft="@drawable/wf"
                android:gravity="center"
                android:paddingStart="@dimen/fab_margin"
                android:text="Vous êtes hors Connexion"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:visibility="gone">

            </TextView>
            <include layout="@layout/classes"></include>
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:background="@color/rouge"
            android:id="@+id/marge"
            android:alpha="0.5"
            android:visibility="gone"
            android:layout_marginLeft="17dp"
            android:layout_height="match_parent">
        </View>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/exp"
        android:visibility="gone"
        android:layout_height="wrap_content">
        <include layout="@layout/expand_fab"></include>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:background="@color/colorBlack"
        android:elevation="40dp"
        android:alpha="0.5"
        android:visibility="gone"
        android:id="@+id/vides"
        android:orientation="vertical"
        android:layout_height="match_parent">

    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_gravity="bottom"
        android:elevation="50dp"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:paddingHorizontal="8dp"
            android:layout_marginHorizontal="8dp"
            android:paddingBottom="@dimen/fab_margin"
            android:id="@+id/sheet"
            android:visibility="gone"
            android:orientation="vertical"

            android:background="@drawable/shap_tabe_haut"
            android:layout_height="wrap_content">

        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:id="@+id/doc"
        android:visibility="gone"
        android:elevation="45dp"
        android:layout_gravity="bottom"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shap_vide2"
            android:backgroundTint="@color/white"
            android:paddingVertical="4dp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="wrap_content"
                android:layout_gravity="top|left"
                android:layout_height="wrap_content"
                android:layout_weight="0.1"
                android:elevation="4dp"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit ="marquee_forever"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:id="@+id/titre"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sélectionner une action"
                    android:textColor="@color/textColor"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
        <TableLayout
            android:layout_width="match_parent"
            android:stretchColumns="*"
            android:background="@color/white"
            android:layout_marginHorizontal="1dp"
            android:layout_height="wrap_content">
            <TableRow
                android:layout_marginVertical="12dp"
                >

                <LinearLayout
                    android:orientation="vertical"

                    android:gravity="center">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:layout_width="wrap_content"
                        app:borderWidth="0dp"
                        android:id="@+id/lpdf"
                        app:fabSize="mini"
                        android:src="@drawable/ic_pdf_black_24dp"
                        app:tint="@color/white"
                        android:backgroundTint="@color/colorPrimary"
                        android:layout_height="wrap_content">

                    </com.google.android.material.floatingactionbutton.FloatingActionButton>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Documents"
                        android:textColor="@color/textColor"
                        android:layout_marginTop="8sp"
                        android:textSize="12sp"
                        android:layout_height="wrap_content">

                    </TextView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"

                    android:gravity="center">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:layout_width="wrap_content"
                        app:borderWidth="0dp"
                        app:fabSize="mini"
                        android:src="@drawable/ic_camera_alt_black_24dp_blanc"
                        app:tint="@color/white"
                        android:backgroundTint="@color/colorPrimary"
                        android:id="@+id/camera"
                        android:layout_height="wrap_content">

                    </com.google.android.material.floatingactionbutton.FloatingActionButton>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Caméra"
                        android:layout_marginTop="8sp"
                        android:textSize="12sp"
                        android:textColor="@color/textColor"
                        android:layout_height="wrap_content">

                    </TextView>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"

                    android:gravity="center">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:layout_width="wrap_content"
                        android:id="@+id/galerie"
                        android:src="@drawable/baseline_image_24"
                        app:tint="@color/white"
                        app:fabSize="mini"
                        android:backgroundTint="@color/colorPrimary"
                        android:layout_height="wrap_content">

                    </com.google.android.material.floatingactionbutton.FloatingActionButton>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Galerie"
                        android:layout_marginTop="8sp"
                        android:textSize="12sp"
                        android:textColor="@color/textColor"
                        android:layout_height="wrap_content">

                    </TextView>
                </LinearLayout>
            </TableRow>
        </TableLayout>
    </LinearLayout>
    <ImageView
        android:layout_width="35dp"
        android:padding="2dp"
        android:id="@+id/search_icon"
        android:visibility="visible"
        app:tint="@color/white"
        android:layout_gravity="end|top"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="14dp"
        android:layout_height="25dp">

    </ImageView>
    <TextView
        android:ellipsize="marquee"
        android:id="@+id/valider"
        android:layout_gravity="top|end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/fab_margin"
        android:layout_marginEnd="8dp"
        android:textAllCaps="true"
        android:visibility="gone"
        android:paddingHorizontal="@dimen/fab_margin"
        android:paddingVertical="5dp"
        android:text="Valider"
        android:textColor="@color/colorPrimary"
        android:background="@drawable/custom_search_bar"
        android:textSize="17sp"
        android:textStyle="bold" />
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:layout_width="match_parent"
        app:elevation="15dp"
        android:elevation="14dp"
        android:visibility="gone"
        android:layout_gravity="bottom"
        android:id="@+id/bottom_navigation"
        android:background="@drawable/shap_botom_navigation"
        app:itemIconTint="@drawable/selector"
        app:itemTextColor="@drawable/selector"
        android:layout_height="wrap_content">

    </com.google.android.material.bottomnavigation.BottomNavigationView>
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_gravity="bottom"
        android:id="@+id/bottom_l"
        android:visibility="gone"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:id="@+id/button0"
            android:backgroundTint="@color/colorAccent"
            android:textAllCaps="false"
            android:paddingVertical="4sp"
            android:text="Annuller"
            android:layout_height="wrap_content">

        </com.google.android.material.button.MaterialButton>
        <com.google.android.material.button.MaterialButton
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:id="@+id/button"
            android:textAllCaps="false"
            android:paddingVertical="4sp"
            android:text="Valider"
            android:layout_height="wrap_content">

        </com.google.android.material.button.MaterialButton>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>