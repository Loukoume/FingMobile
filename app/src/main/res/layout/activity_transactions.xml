<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        tools:context=".TransactionsActivity">

        <!-- Header bar -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/backgrund2"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/backArrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/back"
                app:tint="@color/black"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="transactions"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginStart="16dp"
                android:textColor="@color/black" />
        </LinearLayout>

        <!-- Balance section -->
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/balanceSection"
            android:layout_width="0dp"
            android:background="@drawable/shap_tabe_body"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="@dimen/fab_margin"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/balance_section_bg"
                >

                <TextView
                    android:id="@+id/accountNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Compte N° 43236460005"
                    android:textSize="16sp"
                    android:layout_marginTop="@dimen/fab_margin"
                    android:textStyle="bold"
                    android:textColor="@color/black" />
                <View
                    android:layout_width="match_parent"
                    android:background="@color/colorSendre"
                    android:layout_marginVertical="@dimen/fab_margin"
                    android:layout_height="1dp">
                </View>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Solde disponible"
                    android:textAllCaps="true"
                    android:textSize="15sp"
                    android:alpha="0.5"
                    android:textStyle="bold"
                    android:textColor="@color/textColor"
                    android:layout_marginTop="@dimen/fab_margin" />
                <TextView
                    android:id="@+id/soldeDisponible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 577 XOF"
                    android:textSize="20sp"
                    android:paddingTop="8dp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>
                <View
                    android:layout_width="match_parent"
                    android:background="@color/colorSendre"
                    android:layout_marginTop="@dimen/fab_margin"
                    android:layout_height="1dp">
                </View>

                <TextView
                    android:id="@+id/type_compte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="@color/colorAccent"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Transactions List -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:id="@+id/recycler_lineair"
            app:layout_constraintTop_toBottomOf="@id/balanceSection"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="horizontal"
                android:padding="8dp"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:textAllCaps="true"
                    android:layout_gravity="center_vertical"
                    android:text="dernières opérations"
                    android:layout_height="wrap_content">
                </TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:gravity="end"
                    android:id="@+id/lexpand"
                    android:paddingVertical="5dp"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Voir plus"
                        android:id="@+id/text_expand"
                        android:visibility="visible"
                        android:drawableEnd="@drawable/ic_keyboard_arrow_up_black_24dp"
                        android:layout_height="wrap_content">
                    </TextView>
                    <TextView
                        android:layout_width="wrap_content"
                        android:text="Voir moins"
                        android:id="@+id/text_close"
                        android:visibility="gone"
                        android:drawableEnd="@drawable/ic_keyboard_arrow_down_black_24dp_bleu"
                        android:layout_height="wrap_content">
                    </TextView>
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/transactionList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_width="match_parent"
        android:background="@color/black_transparant"
        android:id="@+id/vide"
        android:visibility="gone"
        android:layout_height="match_parent">

    </View>
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/pb"
        android:visibility="gone"
        android:layout_height="wrap_content">

    </ProgressBar>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
