<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1) Ombre portée (même taille que la carte) -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="300dp"
                android:height="190dp"/>
            <solid android:color="#22000000"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- 2) Fond principal avec gradient HORIZONTAL et bordure -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <size
                android:width="300dp"
                android:height="190dp"/>
            <gradient
                android:angle="0"
                android:startColor="#FF4A90E2"
                android:centerColor="#FF50A7F9"
                android:endColor="#FF7FC1F9"/>
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- 3) Puce EMV stylisée -->
    <item android:top="24dp" android:left="24dp">
        <shape android:shape="rectangle">
            <size android:width="36dp" android:height="28dp"/>
            <solid android:color="#CCCCCCCC"/>
            <corners android:radius="3dp"/>
        </shape>
    </item>

    <!-- 4) Bande magnétique -->
    <item android:top="60dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <size android:height="12dp" android:width="300dp"/>
            <solid android:color="#FF1A1A1A"/>
        </shape>
    </item>

    <!-- 5) Holo-stripe verticale -->
    <item android:top="16dp" android:right="16dp">
        <shape android:shape="rectangle">
            <size android:width="2dp" android:height="40dp"/>
            <gradient
                android:angle="90"
                android:startColor="#80FFFFFF"
                android:endColor="#00FFFFFF"/>
            <corners android:radius="1dp"/>
        </shape>
    </item>

</layer-list>
