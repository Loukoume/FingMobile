<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content"
    >
    <androidx.coordinatorlayout.widget.CoordinatorLayout
       android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/sharp_edite"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_height="match_parent">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:id="@+id/balance_contente"
                    android:gravity="center"
                    >

                    <TextView
                        android:id="@+id/accountNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Compte N° 43236460005"
                        android:textSize="16sp"
                        android:layout_marginTop="@dimen/fab_margin"
                        android:textStyle="bold"
                        android:textColor="@color/black" />
                    <TextView
                        android:id="@+id/type_compte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="@color/colorAccent"
                        android:layout_marginTop="4dp" />
                    <View
                        android:layout_width="match_parent"
                        android:id="@+id/view1"
                        android:background="@color/colorSendre"
                        android:layout_marginVertical="8dp"
                        android:layout_height="1dp">
                    </View>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Solde disponible"
                        android:textAllCaps="true"
                        android:textSize="15sp"
                        android:alpha="0.5"
                        android:id="@+id/libelle"
                        android:textStyle="bold"
                        android:textColor="@color/textColor"
                        />
                    <TextView
                        android:id="@+id/soldeDisponible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 577 XOF"
                        android:textSize="20sp"
                        android:paddingTop="8dp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"/>
                    <View
                        android:layout_width="match_parent"
                        android:background="@color/colorSendre"
                        android:layout_marginTop="@dimen/fab_margin"
                        android:id="@+id/view2"
                        android:layout_height="1dp">
                    </View>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:background="@color/black"
            android:id="@+id/vide"
            android:visibility="visible"
            android:alpha="0.6"
            android:layout_weight="1"
            android:layout_height="0dp">
        </View>
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_gravity="center"
            android:id="@+id/prb"
            android:visibility="gone"
            android:layout_height="wrap_content">

        </ProgressBar>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>