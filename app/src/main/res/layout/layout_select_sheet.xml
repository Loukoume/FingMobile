<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/shape_vide"
    android:paddingBottom="@dimen/fab_margin"
    android:layout_height="wrap_content">
    <TextView
        android:layout_width="wrap_content"
        android:text="Choisisez le mode"
        android:layout_marginVertical="2dp"
        android:textSize="20dp"
        android:visibility="gone"
        android:textColor="@color/black"
        android:layout_height="wrap_content">
    </TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:alpha="0.9"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:gravity="center_horizontal"
        android:text="Ajouter des bénéficiaires externes à votre compte.
Soit manuellement, lire un Qr code ou scanner le Qr code du compte."
        android:layout_height="wrap_content">

    </TextView>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="@dimen/fab_margin"
        android:paddingHorizontal="@dimen/fab_margin"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="start"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="40dp"
                android:layout_gravity="center"
                android:id="@+id/editer"
                app:tint="@color/colorPrimary"
                android:src="@drawable/edition_multiple_100"
                android:layout_height="40dp">

            </ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/fab_margin"
                android:text="Editer"
                android:layout_height="wrap_content">
            </TextView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="center"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="40dp"
                android:src="@drawable/qr_code"
                android:id="@+id/qr_code"
                app:tint="@color/colorPrimary"
                android:layout_gravity="center"
                android:layout_height="40dp">
            </ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:text="Lire un Qr code"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_height="wrap_content">
            </TextView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="end"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="40dp"
                android:src="@drawable/qr_code_100"
                android:layout_gravity="center"
                app:tint="@color/colorPrimary"
                android:id="@+id/balayer"
                android:layout_height="40dp">
            </ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:layout_gravity="center"
                android:text="Balayage"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_height="wrap_content">
            </TextView>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>