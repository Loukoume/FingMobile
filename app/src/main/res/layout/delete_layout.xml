<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/shape_vide"
    android:paddingBottom="@dimen/fab_margin"
    android:layout_height="wrap_content">

    <TextView
        android:layout_width="wrap_content"
        android:layout_marginHorizontal="@dimen/fab_margin"
        android:alpha="0.9"
        android:layout_marginTop="8dp"
        android:textSize="15sp"
        android:gravity="center_horizontal"
        android:text="Vous êtes sur le point de supprimer le bénéficiaire!"
        android:layout_height="wrap_content">

    </TextView>
    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/l_delete"
        android:layout_marginTop="@dimen/fab_margin"
        android:layout_marginHorizontal="@dimen/fab_margin"
        android:layout_height="wrap_content">
        <include layout="@layout/bouton"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/l_edite"
        android:visibility="gone"
        android:layout_marginHorizontal="@dimen/fab_margin"
        android:layout_marginTop="@dimen/fab_margin"
        android:layout_height="wrap_content">
        <include layout="@layout/two_button"/>
    </LinearLayout>
</LinearLayout>