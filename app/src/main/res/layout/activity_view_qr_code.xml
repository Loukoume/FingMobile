<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.ViewQrCodeActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:background="@color/backgrund2"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:background="@drawable/shape_en_s"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/fab_margin"
                android:textSize="18dp"
                android:gravity="center"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:layout_marginHorizontal="@dimen/fab_margin"
                android:text="Transferez votre compte par code Qr"
                android:layout_height="wrap_content">

            </TextView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:background="@color/backgrund2"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal">

                <!-- Titre ou description -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Votre QR Code"
                    android:textSize="20sp"
                    android:visibility="gone"
                    android:paddingBottom="8dp"/>

                <!-- Vue pour le QR Code -->
                <ImageView
                    android:id="@+id/iv_qrcode"
                    android:layout_width="256dp"
                    android:layout_height="256dp"
                    android:contentDescription="QR Code"/>
                <!-- Espace -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />

                <!-- Autres informations -->


            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:gravity="bottom|center"
                android:layout_height="match_parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/share"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Partager le code Qr"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginBottom="@dimen/fab_margin"
                    app:icon="@drawable/baseline_share_40"
                    app:iconPadding="8dp"
                    android:iconTint="@color/white"
                    android:backgroundTint="@color/colorPrimary"
                    app:iconGravity="textStart"/>


            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:background="@color/black_transparant"
        android:id="@+id/vide"
        android:visibility="gone"
        android:layout_height="match_parent">

    </View>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_gravity="bottom"
        android:id="@+id/sheet"
        android:layout_marginHorizontal="5dp"
        android:orientation="vertical"
        android:background="@null"
        android:layout_height="wrap_content">

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>