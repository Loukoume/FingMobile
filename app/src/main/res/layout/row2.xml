<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Image de l'utilisateur avec bordure circulaire -->
            <ImageView
                android:id="@+id/image_user"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:scaleType="centerCrop"
                android:visibility="visible"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:srcCompat="@drawable/user"
                android:contentDescription="User profile picture"
                android:background="@drawable/circle_border_background"
                android:elevation="8dp"/>

            <!-- Nom de l'utilisateur avec style plus visible -->
            <TextView
                android:id="@+id/text_user_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Nom de l'utilisateur"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginLeft="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/image_user"
                app:layout_constraintEnd_toEndOf="parent"
                android:ellipsize="end"
                android:maxLines="1"/>

            <!-- Informations supplémentaires de l'utilisateur -->
            <TextView
                android:id="@+id/text_user_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Statut: Actif"
                android:layout_marginLeft="8dp"
                android:textSize="14sp"
                android:textColor="@color/textColor"
                app:layout_constraintTop_toBottomOf="@id/text_user_name"
                app:layout_constraintStart_toEndOf="@id/image_user"
                app:layout_constraintEnd_toEndOf="parent"
                android:ellipsize="end"
                android:maxLines="1"/>

            <!-- Liste des commissions de l'utilisateur sous forme de chips -->
            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="8dp"
                app:layout_constraintTop_toBottomOf="@id/text_user_info"
                app:layout_constraintStart_toEndOf="@id/image_user"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp">
                <LinearLayout
                    android:id="@+id/layout_commission_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >


                </LinearLayout>
            </HorizontalScrollView>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_gravity="top|right"
            android:layout_marginHorizontal="8dp"
            android:text="Payer"
            android:textColor="@color/textColor"
            android:textAllCaps="true"
            android:id="@+id/payer"
            android:padding="8dp"
            android:layout_height="wrap_content">
        </TextView>
        <ProgressBar
            android:layout_width="50dp"
            android:layout_gravity="top|right"
            android:layout_marginHorizontal="8dp"
            android:padding="8dp"
            android:visibility="gone"
            android:id="@+id/pgc"
            android:layout_height="50dp">

        </ProgressBar>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</androidx.cardview.widget.CardView>
