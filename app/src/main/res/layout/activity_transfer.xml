<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:background="@color/colorSendre"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:background="@drawable/shape_en_s"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/tx_text"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:text="Transfert d'argent"
                android:textAllCaps="true"
                android:layout_margin="@dimen/fab_margin"
                android:layout_height="wrap_content">
            </TextView>
            <TextView
                android:layout_width="match_parent"
                android:text="Transfert entre mes comptes"
                android:textSize="18sp"
                android:gravity="start"
                android:id="@+id/tv_type"
                android:textColor="@color/white"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_marginStart="70dp"
                android:layout_height="wrap_content">

            </TextView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="match_parent">
            <include layout="@layout/layout_transfert_viewpager"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_gravity="bottom"
        android:visibility="gone"
        android:layout_height="wrap_content">
        <include layout="@layout/two_button"/>
    </LinearLayout>
    <ImageView
        android:layout_width="30dp"
        android:src="@drawable/carte_50"
        android:visibility="visible"
        android:layout_gravity="start|top"
        android:layout_marginStart="@dimen/fab_margin"
        android:layout_marginTop="70dp"
        android:layout_height="30dp">

    </ImageView>
    <ImageView
        android:layout_width="30dp"
        android:src="@drawable/ic_keyboard_arrow_down_black_24dp_bleu"
        android:layout_gravity="end|top"
        android:id="@+id/type_tr_icone"
        android:visibility="gone"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginTop="65dp"
        app:tint="@color/white"
        android:layout_height="40dp">
    </ImageView>
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/pb"
        android:visibility="gone"
        android:layout_height="wrap_content">

    </ProgressBar>
    <View
        android:layout_width="match_parent"
        android:background="@color/black"
        android:id="@+id/vde"
        android:alpha="0.6"
        android:visibility="gone"
        android:layout_height="match_parent">

    </View>
    <LinearLayout
        android:layout_width="match_parent"
        android:visibility="gone"
        android:id="@+id/network"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <include layout="@layout/network_layout"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:visibility="gone"
        android:id="@+id/confirm"
        android:background="@color/colorSendre"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <include layout="@layout/confirm_layout"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
