<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.Beneficiaire">
    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:background="@drawable/shape_en_s"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/tx_text"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:text="Remboursement de prêt"
                android:textAllCaps="true"
                android:layout_margin="@dimen/fab_margin"
                android:layout_height="wrap_content">
            </TextView>
            <TextView
                android:layout_width="wrap_content"
                android:text="Simple, rapide et sécurisé"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_marginStart="70dp"
                android:layout_height="wrap_content">

            </TextView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/fab_margin"
            android:layout_marginHorizontal="8dp"
            android:layout_height="match_parent">
            <include layout="@layout/input_drop_mt_outlin"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textFieldMontant"
                android:layout_width="match_parent"
                app:hintTextColor="@color/colorAccent"
                app:hintEnabled="true"
                app:boxBackgroundMode="outline"
                android:hint="Montant"
                app:boxBackgroundColor="@color/white"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:id="@+id/id_montant"
                    android:inputType="numberDecimal"
                    android:layout_height="wrap_content"
                    />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fab_margin"
                android:hint="Observation"
                app:boxBackgroundColor="@color/white"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxBackgroundMode="outline">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:maxLines="5"
                    android:gravity="top|start" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:gravity="bottom"
                android:layout_marginBottom="@dimen/fab_margin"
                android:layout_height="match_parent">
                <include layout="@layout/bouton"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:background="@color/black"
        android:id="@+id/vid"
        android:alpha="0.5"
        android:elevation="17dp"
        android:visibility="gone"
        android:layout_height="match_parent">
    </View>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_gravity="bottom"
        android:id="@+id/sheet"
        android:elevation="18dp"
        android:layout_marginHorizontal="4dp"
        android:orientation="vertical"
        android:background="@null"
        android:layout_height="wrap_content">

    </LinearLayout>
    <ImageView
        android:layout_width="30dp"
        android:src="@drawable/groupe_64"
        android:layout_gravity="start|top"
        android:layout_marginStart="@dimen/fab_margin"
        android:layout_marginTop="65dp"
        android:layout_height="30dp">
    </ImageView>
    <View
        android:layout_width="match_parent"
        android:background="@color/black"
        android:alpha="0.7"
        android:id="@+id/vide"
        android:visibility="gone"
        android:layout_height="match_parent">

    </View>
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_gravity="center"
        android:id="@+id/pb"
        android:visibility="gone"
        android:layout_height="wrap_content">

    </ProgressBar>
    <LinearLayout
        android:layout_width="match_parent"
        android:visibility="gone"
        android:id="@+id/network"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <include layout="@layout/network_layout"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>