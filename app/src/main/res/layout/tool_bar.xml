<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_en_s"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/select_type_evaluation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fab_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="2dp"
                android:src="@drawable/back"
                android:visibility="visible"
                app:tint="@color/white">

            </ImageView>

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/profile_image"
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:layout_marginVertical="2dp"

                    android:src="@drawable/user"
                    android:visibility="gone"
                    app:civ_border_color="@color/argent"
                    app:civ_border_width="2dp" />

                <View
                    android:id="@+id/star"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_gravity="top|left"
                    android:layout_marginLeft="35dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/circle_background_red"
                    android:visibility="gone">

                </View>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>

            <LinearLayout
                android:id="@+id/tool"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="30dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tx_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:fontFamily="@font/exo_medium"
                    android:paddingHorizontal="2dp"
                    android:textColor="@color/white"
                    android:textSize="18dp"
                    android:textStyle="bold">

                </TextView>

                <TextView
                    android:id="@+id/sub_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:fontFamily="@font/exo_medium"
                    android:paddingHorizontal="2dp"
                    android:textColor="@color/white"
                    android:textSize="13dp"
                    android:textStyle="normal"
                    android:visibility="gone">
                </TextView>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="60dp"
                android:src="@drawable/logofing_512"
                android:layout_gravity="start|top"
                app:tint="@color/white"
                android:layout_height="60dp">

            </ImageView>
            <TextView
                android:layout_width="wrap_content"
                android:text="Simple, rapide et sécurisé"
                android:textSize="18sp"
                android:layout_marginTop="@dimen/fab_margin"
                android:textColor="@color/white"
                android:layout_height="wrap_content">

            </TextView>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_height="1dp">
        </View>
    </LinearLayout>
    <ImageView
        android:layout_width="35sp"
        android:padding="2sp"
        android:id="@+id/search_icon"
        android:visibility="gone"
        app:tint="@color/argent"
        android:layout_gravity="end|top"
        android:layout_marginEnd="8sp"
        android:src="@drawable/search"
        android:layout_height="match_parent">

    </ImageView>
    <ImageView
        android:layout_width="35sp"
        android:padding="2sp"
        android:id="@+id/ic_mort"
        android:visibility="visible"
        app:tint="@color/white"
        android:layout_gravity="end|top"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="8sp"
        android:src="@drawable/ic_mort_noir"
        android:layout_height="match_parent">

    </ImageView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

