<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    app:cardElevation="5dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:paddingHorizontal="8dp"
        android:background="@drawable/shap_back"
        android:layout_height="wrap_content">
        <LinearLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:orientation="vertical"

            android:layout_marginVertical="8dp"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/title"
                android:textSize="17dp"
                android:textStyle="bold"
                android:text="@string/app_name"
                android:textColor="@color/colorOnPromary"
                android:layout_height="wrap_content">

            </TextView>
            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/secondre"
                android:textSize="12dp"
                android:text="@string/app_name"
                android:layout_marginVertical="5dp"
                android:alpha="0.6"
                android:layout_height="wrap_content">

            </TextView>
            <TableLayout
                android:layout_width="match_parent"
                android:stretchColumns="*"
                android:layout_marginTop="@dimen/fab_margin"
                android:layout_height="wrap_content">
                <TableRow
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:id="@+id/date"
                        android:textSize="12dp"
                        android:textColor="@color/colorOnPromary"
                        android:text="01 jan 2022"
                        android:layout_height="wrap_content">

                    </TextView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:id="@+id/textePourcentage"
                        android:gravity="center"
                        android:textSize="14dp"
                        android:textColor="@color/colorOnPromary"
                        android:paddingVertical="5dp"
                        android:text="2000"
                        android:layout_height="wrap_content">

                    </TextView>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:id="@+id/plus"
                        android:layout_gravity="end"
                        android:src="@drawable/plus_argant"
                        android:layout_height="wrap_content">
                    </ImageView>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:id="@+id/menu"
                        android:layout_gravity="end"
                        android:src="@drawable/ic_mort_noir"
                        android:layout_height="wrap_content">

                    </ImageView>
                </TableRow>
            </TableLayout>
            <View
                android:layout_width="match_parent"
                android:background="@color/colorOnPromary"
                android:alpha="0.4"
                android:visibility="gone"
                android:layout_marginVertical="8dp"
                android:layout_height="1dp">
            </View>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:textColor="@color/teal_700"
            android:id="@+id/title2"
            android:textStyle="bold"
            android:layout_marginVertical="8dp"
            android:text="5000"
            android:textSize="17dp"
            android:layout_gravity="top|right"
            android:layout_height="wrap_content">

        </TextView>
        <TextView
            android:layout_width="wrap_content"
            android:textColor="@color/colorOnPromary"
            android:id="@+id/secondre2"
            android:layout_marginTop="35dp"
            android:textStyle="normal"
            android:alpha="0.5"
            android:text=""
            android:textSize="13dp"
            android:layout_gravity="top|right"
            android:layout_height="wrap_content">

        </TextView>
        <ImageView
            android:layout_width="wrap_content"
            android:id="@+id/delete"
            android:layout_gravity="center|top"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:src="@drawable/baseline_delete_forever_24"
            android:layout_height="wrap_content">

        </ImageView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</com.google.android.material.card.MaterialCardView>
