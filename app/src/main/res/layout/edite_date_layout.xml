<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:stretchColumns="1">

    <TableRow android:paddingVertical="8dp">
        <TextView
            android:text="Monnaie"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/txtMonnaie"
            android:layout_width="wrap_content"
            android:gravity="end"
            android:text="US Dollar ($)"
            android:textColor="#000000"
            android:textSize="16sp" />
    </TableRow>

    <TableRow android:paddingVertical="12dp">
        <TextView
            android:text="Date limite de \nsoumission"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/txtDateSoumission"
            android:layout_width="wrap_content"
            android:gravity="end"
            android:text="10-01-2026"
            android:textColor="#000000"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />
    </TableRow>

    <TableRow android:paddingVertical="12dp">
        <TextView
            android:text="Date de paiement \nattendue"
            android:textColor="#888888"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/txtDatePaiement"
            android:layout_width="wrap_content"
            android:gravity="end"
            android:drawableEnd="@android:drawable/ic_menu_edit"
            android:drawablePadding="8dp"
            android:text="10-01-2026"
            android:textColor="#000000"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />
    </TableRow>
</TableLayout>